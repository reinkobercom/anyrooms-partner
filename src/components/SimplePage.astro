---
/**
 * Schlichtes Seitengerüst im Stil des Hero-Bereichs (Dankeseite, 404):
 * Logo-Leiste, eine Karte mit Inhalt, darunter Kontakt + Fußzeile.
 */
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import ContactButtons from './ContactButtons.astro';
import SiteFooter from './SiteFooter.astro';
import { site } from '../data/site';
import { images } from '../data/images';
---

<section class="root" style="background-color: var(--color-kit-dark); --accent: var(--color-kit-key1);">
  <div class="lines" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="inner">
    <header class="brandBar">
      <a class="brand" href="/" aria-label="Zur Startseite für Vermieter">
        <Logo tone="onDark" width={168} title={images.logo.alt} />
        <span class="brandTag">{site.brandTagline}</span>
      </a>
      <a class="ui-btn ui-btn--ghost ui-btn--sm" href={site.headerContact.href}>
        {site.headerContact.icon !== 'none' && <Icon name={site.headerContact.icon} size={16} />}
        <span>{site.headerContact.label}</span>
      </a>
    </header>

    <div class="cardWrap ui-enter" style="--enter-y: 26px;">
      <div class="ui-card ui-card--light ui-card--p-lg">
        <slot />
      </div>
    </div>

    <ContactButtons title="Lieber direkt sprechen?" />
    <SiteFooter />
  </div>
</section>

<style>
  .root {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    font-family: var(--font-kit-text-font);
    padding: 20px 0 40px;
  }
  .glow {
    position: absolute;
    top: -280px;
    right: -190px;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(circle, #f5a5242e 0%, #f5a52400 66%);
    pointer-events: none;
  }
  .lines {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(#ffffff0f 1px, transparent 1px);
    background-size: 100% 58px;
    pointer-events: none;
  }
  .inner {
    position: relative;
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .brandBar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 0 clamp(34px, 5vw, 62px);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    border-radius: 8px;
  }
  .brand:focus-visible {
    outline: 3px solid var(--color-kit-key1);
    outline-offset: 4px;
  }
  .brandTag {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffffa3;
  }
  .cardWrap {
    max-width: 620px;
    margin: 0 auto;
  }
  @media (max-width: 560px) {
    .inner { padding: 0 18px; }
    .brandTag { display: none; }
  }
</style>
