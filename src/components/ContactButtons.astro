---
import Icon from './ui/Icon.astro';
import { site } from '../data/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="contact">
  <p class="ui-text ui-text--sm ui-text--invertMuted ui-text--center">{title}</p>
  <div class="contactRow">
    {
      site.contacts.map((contact) => (
        <a class="ui-btn ui-btn--ghost" href={contact.href}>
          {contact.icon !== 'none' && <Icon name={contact.icon} />}
          <span>{contact.label}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .contact {
    margin-top: clamp(38px, 5vw, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .contactRow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
</style>
