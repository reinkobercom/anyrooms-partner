---
import Badge from '../ui/Badge.astro';
import Headline from '../ui/Headline.astro';
import { howItWorks as c } from '../../data/content';
---

<section class="root" style="background-color: var(--color-kit-light); --accent: var(--color-kit-key1);" aria-labelledby="how-title">
  <div class="inner">
    <div class="layout">
      <div>
        <Badge tone="onLight">{c.kicker}</Badge>
        <div class="headline" id="how-title">
          <Headline as="h2" size="lg" text={c.headline} />
        </div>
        <p class="ui-text ui-text--muted">{c.intro}</p>
      </div>

      <ol class="steps">
        {
          c.steps.map((s, index) => (
            <li class="step" data-reveal style={`--reveal-y: 18px; --reveal-duration: 0.4s; --reveal-delay: ${index * 0.08}s;`} data-reveal-amount="0.4">
              <span class="num" aria-hidden="true">{index + 1}</span>
              <div class="stepBody">
                <h3 class="ui-title ui-title--sm">{s.title}</h3>
                <p class="ui-text ui-text--muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .root {
    position: relative;
    font-family: var(--font-kit-text-font);
    padding: clamp(64px, 9vw, 128px) 0;
  }

  .inner {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(36px, 6vw, 92px);
    align-items: start;
  }

  .headline {
    margin: 18px 0 20px;
  }

  .steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background-color: #103a5d1f;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 22px;
    align-items: start;
  }

  .num {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--accent, #f5a524);
    color: var(--color-kit-dark, #103a5d);
    font-family: var(--font-kit-header-font);
    font-size: 21px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .stepBody {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 6px;
  }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 40px; }
  }

  @media (max-width: 560px) {
    .inner { padding: 0 18px; }
    .step { grid-template-columns: 46px 1fr; gap: 16px; }
    .num { width: 46px; height: 46px; font-size: 18px; }
    .steps::before { left: 22px; }
  }
</style>
