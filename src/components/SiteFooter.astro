---
import { site } from '../data/site';
---

<footer class="footer">
  <p class="ui-text ui-text--xs ui-text--invertMuted">{site.copyright}</p>
  <nav class="footerLinks" aria-label="Rechtliches">
    {
      site.footerLinks.map((link) => (
        <a class="footerLink" href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .footer {
    margin-top: clamp(52px, 7vw, 92px);
    padding-top: 22px;
    border-top: 1px solid #ffffff29;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .footerLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footerLink {
    font-family: var(--font-kit-text-font);
    font-size: 14px;
    color: #ffffffb3;
    text-decoration: none;
    /* Klickfläche ≥ 44 px ohne sichtbare Änderung */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: -12px 0;
  }

  .footerLink:hover {
    color: var(--color-kit-white, #ffffff);
    text-decoration: underline;
  }

  .footerLink:focus-visible {
    outline: 3px solid var(--color-kit-key1, #f5a524);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (max-width: 560px) {
    .footer { justify-content: center; text-align: center; }
  }
</style>
